olumns_bottom_border gt_left\" rowspan=\"1\" colspan=\"1\" style=\"color: #666666;\" scope=\"col\" id=\"الاختبار\">الاختبار</th>\n  <th class=\"gt_col_heading gt_columns_bottom_border gt_left\" rowspan=\"1\" colspan=\"1\" style=\"color: #666666;\" scope=\"col\" id=\"القيمة\">القيمة</th>\n  <th class=\"gt_col_heading gt_columns_bottom_border gt_left\" rowspan=\"1\" colspan=\"1\" style=\"color: #666666;\" scope=\"col\" id=\"الوحدة\">الوحدة</th>\n  <th class=\"gt_col_heading gt_columns_bottom_border gt_center\" rowspan=\"1\" colspan=\"1\" style=\"color: #666666;\" scope=\"col\" id=\"ناجح\">ناجح</th>\n</tr>\n</thead>\n<tbody class=\"gt_table_body\">\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">01</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">flow_hierarchy</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">2</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">ktoe</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">01</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">product_hierarchy</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">2</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">ktoe</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">01</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">availability_identity</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">1.5</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">ktoe</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">02</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">summary2_categories</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">9.1e-13</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">kt CO2 eq</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">02</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">summary2_n2o_1B2</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">0.24</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">kt CO2 eq</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">03</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">supply_total</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">0.69</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">million TND</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">03</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">supply_equals_use</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">0.077</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">million TND</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">03</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">output_identity</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">0.039</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">million TND</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">10</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">conservation</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">4.7e-10</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">TJ</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">10</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">iea_identity</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">3</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">ktoe</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">11</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">factors_sum_to_one</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">1.1e-16</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">share</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">12</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">factors_sum_to_one</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">1.1e-16</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">share</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n  <tr>\n    <td headers=\"البرنامج\" class=\"gt_row gt_right\">12</td>\n    <td headers=\"الاختبار\" class=\"gt_row gt_left\">aviation_bunkers_vs_inventory</td>\n    <td headers=\"القيمة\" class=\"gt_row gt_left\">0.45</td>\n    <td headers=\"الوحدة\" class=\"gt_row gt_left\">percent</td>\n    <td headers=\"ناجح\" class=\"gt_row gt_center\">True</td>\n  </tr>\n</tbody>\n\n</table>\n\n</div>\n```\n:::\n:::\n\n\n## المخرجات\n\n- مصنفات إكسل **بالإنجليزية والفرنسية والعربية**، بعرض أوراق الأداتين.\n- جداول بصيغتي CSV وParquet للتحليل.\n- وثائق منهجية ومستكشف بيانات يُحدَّثان مع كل تشغيل.\n\n## المراجع\n\n::: {#refs}\n:::\n\n",
